def edit_tour_page():

    tour_id = st.session_state.get(
        "edit_tour_id"
    )

    if not tour_id:
        st.session_state.page = "manage_tours"
        st.rerun()

    tour = get_tour(tour_id)

    if not tour:

        st.error("Không tìm thấy tour.")

        return

    st.title("✏️ Chỉnh sửa tour")

    with st.form("edit_tour_form"):

        name = st.text_input(
            "Tên tour",
            value=tour["name"]
        )

        destination = st.text_input(
            "Điểm đến",
            value=tour["destination"]
        )

        description = st.text_area(
            "Mô tả",
            value=tour["description"] or ""
        )

        duration = st.text_input(
            "Thời gian",
            value=tour["duration"] or ""
        )

        price = st.number_input(
            "Giá / người",
            min_value=0,
            value=float(tour["price"]),
            step=100000.0
        )

        max_people = st.number_input(
            "Số khách tối đa",
            min_value=1,
            value=int(tour["max_people"])
        )

        image = st.text_input(
            "URL hình ảnh",
            value=tour["image"] or ""
        )

        status = st.selectbox(
            "Trạng thái",
            ["Đang mở", "Đã đóng"],
            index=0 if tour["status"] == "Đang mở" else 1
        )

        c1, c2 = st.columns(2)

        with c1:

            save = st.form_submit_button(
                "💾 Lưu thay đổi",
                use_container_width=True
            )

        with c2:

            cancel = st.form_submit_button(
                "❌ Hủy",
                use_container_width=True
            )

        if save:

            conn = get_connection()

            conn.execute("""
                UPDATE tours
                SET
                    name = ?,
                    destination = ?,
                    description = ?,
                    duration = ?,
                    price = ?,
                    max_people = ?,
                    image = ?,
                    status = ?
                WHERE id = ?
            """, (
                name,
                destination,
                description,
                duration,
                price,
                max_people,
                image,
                status,
                tour_id
            ))

            conn.commit()
            conn.close()

            st.success(
                "Đã cập nhật tour!"
            )

            del st.session_state["edit_tour_id"]

            st.session_state.page = "manage_tours"

            st.rerun()

        if cancel:

            del st.session_state["edit_tour_id"]

            st.session_state.page = "manage_tours"

            st.rerun()


