# =========================
# TRANG CHỦ
# =========================

@app.route("/")
def home():
    return render_template("index.html", tours=tours)


# =========================
# DANH SÁCH TOUR
# =========================

@app.route("/tours")
def tour_list():
    keyword = request.args.get("keyword", "").strip().lower()

    if keyword:
        result = [
            tour for tour in tours
            if keyword in tour["name"].lower()
            or keyword in tour["location"].lower()
        ]
    else:
        result = tours

    return render_template(
        "tours.html",
        tours=result,
        keyword=keyword
    )


# =========================
# CHI TIẾT TOUR
# =========================

@app.route("/tour/<int:tour_id>")
def tour_detail(tour_id):
    tour = next((t for t in tours if t["id"] == tour_id), None)

    if not tour:
        return "Không tìm thấy tour", 404

    return render_template("tour_detail.html", tour=tour)


# =========================
# ĐẶT TOUR
# =========================

@app.route("/book/<int:tour_id>", methods=["GET", "POST"])
def book_tour(tour_id):
    tour = next((t for t in tours if t["id"] == tour_id), None)

    if not tour:
        return "Không tìm thấy tour", 404

    if request.method == "POST":

        customer_name = request.form.get("customer_name")
        phone = request.form.get("phone")
        email = request.form.get("email")
        travel_date = request.form.get("travel_date")

        try:
            adults = int(request.form.get("adults", 1))
            children = int(request.form.get("children", 0))
        except ValueError:
            flash("Số lượng khách không hợp lệ.")
            return redirect(url_for("book_tour", tour_id=tour_id))

        if adults < 1:
            flash("Phải có ít nhất 1 người lớn.")
            return redirect(url_for("book_tour", tour_id=tour_id))

        # Trẻ em tính 70% giá tour
        total = (
            adults * tour["price"]
            + children * tour["price"] * 0.7
        )

        booking = {
            "id": len(bookings) + 1,
            "tour_id": tour["id"],
            "tour_name": tour["name"],
            "customer_name": customer_name,
            "phone": phone,
            "email": email,
            "travel_date": travel_date,
            "adults": adults,
            "children": children,
            "total": int(total),
            "status": "Chờ xác nhận"
        }

        bookings.append(booking)

        return render_template(
            "booking_success.html",
            booking=booking
        )

    return render_template("booking.html", tour=tour)


