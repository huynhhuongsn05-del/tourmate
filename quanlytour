@app.route("/admin")
def admin():
    revenue = sum(b["total"] for b in bookings)

    return render_template(
        "admin.html",
        tours=tours,
        bookings=bookings,
        revenue=revenue
    )


# =========================
# THÊM TOUR
# =========================

@app.route("/admin/add-tour", methods=["GET", "POST"])
def add_tour():

    if request.method == "POST":

        name = request.form.get("name")
        location = request.form.get("location")
        duration = request.form.get("duration")
        price = request.form.get("price")
        description = request.form.get("description")
        image = request.form.get("image")

        try:
            price = int(price)
        except ValueError:
            flash("Giá tour không hợp lệ.")
            return redirect(url_for("add_tour"))

        new_tour = {
            "id": len(tours) + 1,
            "name": name,
            "location": location,
            "duration": duration,
            "price": price,
            "image": image,
            "description": description
        }

        tours.append(new_tour)

        return redirect(url_for("admin"))

    return render_template("add_tour.html")


# =========================
# XÓA TOUR
# =========================

@app.route("/admin/delete-tour/<int:tour_id>")
def delete_tour(tour_id):

    global tours

    tours = [
        tour for tour in tours
        if tour["id"] != tour_id
    ]

    return redirect(url_for("admin"))


# =========================
# XÁC NHẬN BOOKING
# =========================

@app.route("/admin/confirm/<int:booking_id>")
def confirm_booking(booking_id):

    booking = next(
        (b for b in bookings if b["id"] == booking_id),
        None
    )

    if booking:
        booking["status"] = "Đã xác nhận"

    return redirect(url_for("admin"))


