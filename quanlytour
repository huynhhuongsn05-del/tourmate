def booking_page():

    tour_id = st.session_state.selected_tour

    tour = get_tour(tour_id)

    if not tour:
        st.error("Không tìm thấy tour.")
        return

    st.title("🎫 Đặt tour")

    st.info(
        f"Bạn đang đặt: **{tour['name']}**"
    )

    col1, col2 = st.columns(2)

    with col1:

        customer_name = st.text_input(
            "Họ và tên *"
        )

        phone = st.text_input(
            "Số điện thoại *"
        )

        email = st.text_input(
            "Email"
        )

    with col2:

        travel_date = st.date_input(
            "Ngày đi *",
            min_value=date.today()
        )

        people = st.number_input(
            "Số lượng người *",
            min_value=1,
            max_value=int(tour["max_people"]),
            value=1
        )

        st.write(
            f"💰 Giá: **{format_money(tour['price'])}/người**"
        )

        total = people * tour["price"]

        st.markdown(
            f"### Tổng tiền: {format_money(total)}"
        )

    note = st.text_area(
        "Ghi chú / yêu cầu đặc biệt"
    )

    st.divider()

    if st.button(
        "✅ XÁC NHẬN ĐẶT TOUR",
        type="primary",
        use_container_width=True
    ):

        if not customer_name.strip():
            st.error("Vui lòng nhập họ tên.")
            return

        if not phone.strip():
            st.error("Vui lòng nhập số điện thoại.")
            return

        if travel_date < date.today():
            st.error("Ngày đi không hợp lệ.")
            return

        conn = get_connection()

        conn.execute("""
            INSERT INTO bookings (
                tour_id,
                customer_name,
                phone,
                email,
                booking_date,
                travel_date,
                people,
                total_price,
                note,
                status
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            tour_id,
            customer_name,
            phone,
            email,
            datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            travel_date.strftime("%Y-%m-%d"),
            people,
            total,
            note,
            "Chờ xác nhận"
        ))

        conn.commit()

        booking_id = conn.execute(
            "SELECT last_insert_rowid()"
        ).fetchone()[0]

        conn.close()

        st.success(
            f"🎉 Đặt tour thành công! Mã đơn của bạn là **#{booking_id}**"
        )

        st.balloons()

        st.markdown(
            f"""
            <div class="success-box">
            <h3>Thông tin đặt tour</h3>
            <p><b>Mã đơn:</b> #{booking_id}</p>
            <p><b>Tour:</b> {tour["name"]}</p>
            <p><b>Khách hàng:</b> {customer_name}</p>
            <p><b>Ngày đi:</b> {travel_date.strftime("%d/%m/%Y")}</p>
            <p><b>Số người:</b> {people}</p>
            <p><b>Tổng tiền:</b> {format_money(total)}</p>
            <p><b>Trạng thái:</b> Chờ xác nhận</p>
            </div>
            """,
            unsafe_allow_html=True
        )


