def format_money(value):
    return f"{value:,.0f} VNĐ".replace(",", ".")


def get_tours(keyword="", destination="Tất cả", status="Tất cả"):
    conn = get_connection()

    query = "SELECT * FROM tours WHERE 1=1"
    params = []

    if keyword:
        query += " AND (name LIKE ? OR destination LIKE ?)"
        params.extend([
            f"%{keyword}%",
            f"%{keyword}%"
        ])

    if destination != "Tất cả":
        query += " AND destination = ?"
        params.append(destination)

    if status != "Tất cả":
        query += " AND status = ?"
        params.append(status)

    query += " ORDER BY id DESC"

    df = pd.read_sql_query(query, conn, params=params)
    conn.close()

    return df


def get_tour(tour_id):
    conn = get_connection()

    tour = conn.execute(
        "SELECT * FROM tours WHERE id = ?",
        (tour_id,)
    ).fetchone()

    conn.close()

    return tour


def get_bookings():
    conn = get_connection()

    query = """
        SELECT
            bookings.id,
            bookings.customer_name,
            bookings.phone,
            bookings.email,
            tours.name AS tour_name,
            tours.destination,
            bookings.travel_date,
            bookings.people,
            bookings.total_price,
            bookings.status,
            bookings.note,
            bookings.booking_date,
            bookings.created_at
        FROM bookings
        JOIN tours ON bookings.tour_id = tours.id
        ORDER BY bookings.id DESC
    """

    df = pd.read_sql_query(query, conn)

    conn.close()

    return df


def login_admin(username, password):
    conn = get_connection()

    password_hash = hashlib.sha256(
        password.encode()
    ).hexdigest()

    admin = conn.execute("""
        SELECT *
        FROM admins
        WHERE username = ?
        AND password = ?
    """, (username, password_hash)).fetchone()

    conn.close()

    return admin is not None


