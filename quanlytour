        CREATE TABLE IF NOT EXISTS tours (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            destination TEXT NOT NULL,
            description TEXT,
            duration TEXT,
            price REAL NOT NULL,
            max_people INTEGER DEFAULT 20,
            image TEXT,
            status TEXT DEFAULT 'Đang mở',
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
