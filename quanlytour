def add_tour_form():

    with st.form("add_tour"):

        name = st.text_input(
            "Tên tour *"
        )

        destination = st.text_input(
            "Điểm đến *"
        )

        description = st.text_area(
            "Mô tả"
        )

        col1, col2 = st.columns(2)

        with col1:

            duration = st.text_input(
                "Thời gian",
                value="3 ngày 2 đêm"
            )

            price = st.number_input(
                "Giá / người",
                min_value=0,
                step=100000,
                value=3000000
            )

        with col2:

            max_people = st.number_input(
                "Số khách tối đa",
                min_value=1,
                value=20
            )

            status = st.selectbox(
                "Trạng thái",
                ["Đang mở", "Đã đóng"]
            )

        image = st.text_input(
            "URL hình ảnh",
            value="https://images.unsplash.com/photo-1500534623283-312aade485b7"
        )

        submit = st.form_submit_button(
            "➕ Thêm tour",
            use_container_width=True
        )

        if submit:

            if not name or not destination:

                st.error(
                    "Tên tour và điểm đến là bắt buộc."
                )

            else:

                conn = get_connection()

                conn.execute("""
                    INSERT INTO tours (
                        name,
                        destination,
                        description,
                        duration,
                        price,
                        max_people,
                        image,
                        status
                    )
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    name,
                    destination,
                    description,
                    duration,
                    price,
                    max_people,
                    image,
                    status
                ))

                conn.commit()
                conn.close()

                st.success(
                    "Đã thêm tour thành công!"
                )

                st.rerun()


