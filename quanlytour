def manage_bookings_page():

    if not st.session_state.admin_logged:
        st.session_state.page = "admin_login"
        st.rerun()

    st.title("📋 Quản lý đơn đặt tour")

    bookings = get_bookings()

    if bookings.empty:

        st.info(
            "Hiện chưa có đơn đặt tour."
        )

        return

    status_filter = st.selectbox(
        "Lọc trạng thái",
        [
            "Tất cả",
            "Chờ xác nhận",
            "Đã xác nhận",
            "Đã hủy"
        ]
    )

    if status_filter != "Tất cả":

        bookings = bookings[
            bookings["status"] == status_filter
        ]

    st.write(
        f"Có **{len(bookings)}** đơn."
    )

    for _, booking in bookings.iterrows():

        with st.expander(
            f"#{booking['id']} - "
            f"{booking['customer_name']} - "
            f"{booking['tour_name']}"
        ):

            col1, col2 = st.columns(2)

            with col1:

                st.write(
                    f"👤 **Khách hàng:** {booking['customer_name']}"
                )

                st.write(
                    f"📞 **Điện thoại:** {booking['phone']}"
                )

                st.write(
                    f"📧 **Email:** {booking['email'] or 'Không có'}"
                )

                st.write(
                    f"🎒 **Tour:** {booking['tour_name']}"
                )

                st.write(
                    f"📍 **Điểm đến:** {booking['destination']}"
                )

            with col2:

                st.write(
                    f"📅 **Ngày đi:** {booking['travel_date']}"
                )

                st.write(
                    f"👥 **Số người:** {booking['people']}"
                )

                st.write(
                    f"💰 **Tổng tiền:** {format_money(booking['total_price'])}"
                )

                st.write(
                    f"📝 **Ghi chú:** {booking['note'] or 'Không có'}"
                )

            current_status = booking["status"]

            new_status = st.selectbox(
                "Trạng thái đơn",
                [
                    "Chờ xác nhận",
                    "Đã xác nhận",
                    "Đã hủy"
                ],
                index=[
                    "Chờ xác nhận",
                    "Đã xác nhận",
                    "Đã hủy"
                ].index(current_status),
                key=f"status_{booking['id']}"
            )

            if st.button(
                "💾 Cập nhật trạng thái",
                key=f"update_{booking['id']}"
            ):

                conn = get_connection()

                conn.execute("""
                    UPDATE bookings
                    SET status = ?
                    WHERE id = ?
                """, (
                    new_status,
                    int(booking["id"])
                ))

                conn.commit()
                conn.close()

                st.success(
                    "Đã cập nhật trạng thái."
                )

                st.rerun()


